{
  "name": "oxide-sloc",
  "displayName": "oxide-sloc",
  "description": "Run oxide-sloc code-metrics reports from VS Code: analyze, view HTML reports, and see live SLOC in the status bar.",
  "version": "0.1.0",
  "publisher": "oxide-sloc",
  "license": "AGPL-3.0-or-later",
  "author": "Nima Shafie",
  "homepage": "https://github.com/oxide-sloc/oxide-sloc-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxide-sloc/oxide-sloc-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/oxide-sloc/oxide-sloc-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "sloc",
    "loc",
    "code metrics",
    "lines of code",
    "coverage"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#59662E",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oxideSloc",
          "title": "Oxide SLOC",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "oxideSloc": [
        {
          "id": "oxideSloc.panel",
          "name": "Metrics",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "oxideSloc.panel",
        "contents": "Analyze your workspace to see live code metrics.\n[Analyze Workspace](command:oxideSloc.analyzeWorkspace)\n\nNo oxide-sloc binary yet? Locate or auto-detect one.\n[Set Up Binary](command:oxideSloc.locateBinary)"
      }
    ],
    "commands": [
      {
        "command": "oxideSloc.analyzeWorkspace",
        "title": "Analyze Workspace",
        "category": "Oxide SLOC",
        "icon": "$(play)"
      },
      {
        "command": "oxideSloc.analyzeCurrent",
        "title": "Analyze Current File/Folder",
        "category": "Oxide SLOC"
      },
      {
        "command": "oxideSloc.openReport",
        "title": "Open HTML Report",
        "category": "Oxide SLOC",
        "icon": "$(file)"
      },
      {
        "command": "oxideSloc.startServe",
        "title": "Start Web UI",
        "category": "Oxide SLOC",
        "icon": "$(globe)"
      },
      {
        "command": "oxideSloc.stopServe",
        "title": "Stop Web UI",
        "category": "Oxide SLOC",
        "icon": "$(circle-slash)"
      },
      {
        "command": "oxideSloc.refreshStatus",
        "title": "Refresh",
        "category": "Oxide SLOC",
        "icon": "$(refresh)"
      },
      {
        "command": "oxideSloc.locateBinary",
        "title": "Locate / Auto-detect Binary",
        "category": "Oxide SLOC",
        "icon": "$(tools)"
      },
      {
        "command": "oxideSloc.configureOptions",
        "title": "Configure Analyze Options",
        "category": "Oxide SLOC",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oxideSloc.analyzeWorkspace",
          "when": "view == oxideSloc.panel",
          "group": "navigation@1"
        },
        {
          "command": "oxideSloc.refreshStatus",
          "when": "view == oxideSloc.panel",
          "group": "navigation@2"
        },
        {
          "command": "oxideSloc.openReport",
          "when": "view == oxideSloc.panel",
          "group": "navigation@3"
        },
        {
          "command": "oxideSloc.configureOptions",
          "when": "view == oxideSloc.panel",
          "group": "1_config@1"
        },
        {
          "command": "oxideSloc.locateBinary",
          "when": "view == oxideSloc.panel",
          "group": "1_config@2"
        },
        {
          "command": "oxideSloc.startServe",
          "when": "view == oxideSloc.panel && !oxideSloc.serveRunning",
          "group": "2_serve@1"
        },
        {
          "command": "oxideSloc.stopServe",
          "when": "view == oxideSloc.panel && oxideSloc.serveRunning",
          "group": "2_serve@1"
        }
      ],
      "explorer/context": [
        {
          "command": "oxideSloc.analyzeCurrent",
          "group": "9_oxideSloc"
        }
      ],
      "editor/title/context": [
        {
          "command": "oxideSloc.analyzeCurrent",
          "group": "9_oxideSloc"
        }
      ],
      "commandPalette": [
        {
          "command": "oxideSloc.startServe",
          "when": "!oxideSloc.serveRunning"
        },
        {
          "command": "oxideSloc.stopServe",
          "when": "oxideSloc.serveRunning"
        }
      ]
    },
    "configuration": {
      "title": "Oxide SLOC",
      "properties": {
        "oxideSloc.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `oxide-sloc` executable. Leave empty to fall back to the `SLOC_BIN` / `OXIDE_SLOC` environment variables, then `oxide-sloc` on `PATH`."
        },
        "oxideSloc.options.perFile": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Include a per-file breakdown in the report (`--per-file`). Edit visually via **Oxide SLOC: Configure Analyze Options**."
        },
        "oxideSloc.options.failOnWarnings": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Exit non-zero if analysis emits any warnings (`--fail-on-warnings`)."
        },
        "oxideSloc.options.activityWindow": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Recent-activity window in days (`--activity-window`). `0` disables it."
        },
        "oxideSloc.options.failBelow": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Fail if total code lines drop below this threshold (`--fail-below`). `0` disables it."
        },
        "oxideSloc.options.maxComplexity": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Fail if cyclomatic complexity exceeds this value (`--max-complexity`). `0` disables it."
        },
        "oxideSloc.analyzeFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Advanced escape hatch: extra flags appended verbatim to `oxide-sloc analyze`, after the friendly options above (for example `--activity-window`, `90`). Most users should use **Oxide SLOC: Configure Analyze Options** instead."
        },
        "oxideSloc.configPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `.oxide-sloc.toml` config file, passed as `--config`. Leave empty to use oxide-sloc's own config discovery."
        },
        "oxideSloc.report.viewer": {
          "type": "string",
          "enum": [
            "external",
            "webview"
          ],
          "enumDescriptions": [
            "Open the HTML report in the default external browser.",
            "Open the HTML report inside a VS Code webview panel."
          ],
          "default": "external",
          "description": "Where to open generated HTML reports."
        },
        "oxideSloc.report.useBinaryOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pass `--open` to oxide-sloc so it opens the report itself, instead of the extension managing the viewer."
        },
        "oxideSloc.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a status-bar item with the workspace code-line count."
        },
        "oxideSloc.statusBar.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Re-analyze and refresh the status bar on every file save. Off by default; can be slow on large workspaces."
        },
        "oxideSloc.serve.port": {
          "type": "number",
          "default": 4317,
          "description": "Port the oxide-sloc web UI listens on when started from VS Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.0",
    "mocha": "^10.7.3",
    "typescript": "^5.4.0"
  }
}
